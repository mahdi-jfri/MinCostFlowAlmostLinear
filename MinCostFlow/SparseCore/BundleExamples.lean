  obtain ⟨oracle, C_lsst, hLSST⟩ := theorem_2_2
  have hSpec := bundleLemma_5_17_isSpecOrdUpTo_of_B_ge_m
    (exBundleEnv C_lsst) oracle (fun _ => idSparsify) hLSST idSparsify_spec (fun m => Nat.le_succ m)
