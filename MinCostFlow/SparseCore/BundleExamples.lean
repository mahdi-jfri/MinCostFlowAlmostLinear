/-- **Concrete instantiation of `bundleLemma_5_17_inst`** on `(exBundleDyn, exBundleOrd)`. -/
theorem ex_bundle_lemma_5_17_inst :
    ∃ oracle C_lsst, HasLSSTSpec oracle C_lsst ∧
      ∃ Ψ : ℝ, ∃ c w : ℕ → ℕ → ℝ,
